# ==============================================================================
# BÚFALO STUDIO - DIRECTADMIN / APACHE HARDENED SECURITY .HTACCESS
# ==============================================================================

# 1. DISABLE DIRECTORY BROWSING / INDEXING
Options -Indexes

# 2. DEFAULT CHARACTER SET
AddDefaultCharset UTF-8

# 3. BLOCK ACCESS TO HIDDEN FILES AND DIRECTORIES (Includes .git, .gitignore, .env)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent reading .git directory or any file/dir starting with a dot
    RewriteRule "(^|/)\." - [F,L]
</IfModule>

# Fallback protection for hidden files (e.g. .git, .env)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. BLOCK ACCESS TO SENSITIVE PROJECT & DOCUMENTATION FILES
<FilesMatch "\.(md|json|lock|log|sh|env|example|sql|bak|config)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Specifically block PROJECT_CONTEXT.md and package.json
<Files "PROJECT_CONTEXT.md">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

<Files "package.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# 5. SECURITY HEADERS (Defensive HTTP Headers)
<IfModule mod_headers.c>
    # Protect against MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Protect against clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # XSS Protection for older browsers
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict unneeded browser capabilities
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 6. PERFORMANCE & CACHING FOR ASSETS (WebP, JPG, SVG, CSS, JS)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript image/svg+xml
</IfModule>
